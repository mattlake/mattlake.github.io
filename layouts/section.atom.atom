{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.Title }} &#8212; {{ .Title }}</title>
  <subtitle>{{ .Params.subtitle | default site.Params.description }}</subtitle>
  <link href="{{ .Permalink }}"/>
  <link rel="self" type="application/atom+xml" href="{{ .Permalink }}feed.atom"/>
  <id>{{ .Permalink }}</id>
  <updated>{{ with (index .Pages 0) }}{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}{{ end }}</updated>
  <author><name>{{ site.Copyright }}</name></author>
  {{ range .Pages }}
    <entry>
      <title>{{ .Title }}</title>
      <link href="{{ .Permalink }}"/>
      <id>{{ .Permalink }}</id>
      <updated>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</updated>
      {{ with or .Params.summary .Summary }}<summary>{{ . | plainify }}</summary>{{ end }}
      <content type="html">{{ .Content | html }}</content>
      {{ range .Params.tags }}<category term="{{ . }}"/>{{ end }}
    </entry>
  {{ end }}
</feed>
